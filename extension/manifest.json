{
  "manifest_version": 3,
  "name": "Alliance",
  "version": "1.3.0",
  "description": "Affiche une interface financière dans la langue choisie à partir de fichiers d'équivalences locaux.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safinum.cm/hackathon-test",
        "https://safinum.cm/hackathon-test/*"
      ],
      "js": ["engine.js", "signal.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["locales/*.json", "audio/*"],
      "matches": ["https://safinum.cm/*"]
    }
  ]
}
